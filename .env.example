NEXT_PUBLIC_BEEHIIV_SUBSCRIBE_URL="https://fishtheflats.beehiiv.com/subscribe"
NEXT_PUBLIC_BEEHIIV_EMBED_URL="https://fishtheflats.beehiiv.com"
BEEHIIV_EMBED_URL="https://fishtheflats.beehiiv.com"
# Official subscribe form (do not invent a different id)
