# Postgres (required). Local example; use the Vercel/Neon/Supabase URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fishtheflats"
ADMIN_PASSWORD="change-me"
# Optional. Canonical site URL for metadata, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Beehiiv — list of record for Last-Minute Flats
